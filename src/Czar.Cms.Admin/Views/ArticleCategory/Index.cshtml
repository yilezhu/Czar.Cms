@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>文章分类管理</title>
    <link rel="stylesheet" href="~/layui/css/layui.css">
    <style>
        body { padding: 10px; }
    </style>
</head>
<body>
    <div class="layui-form layui-form-pane" style="margin-bottom:10px;">
        <div class="layui-form-item">
            <div class="layui-inline">
                <label class="layui-form-label">分类名称</label>
                <div class="layui-input-inline" style="width: 200px;">
                    <input id="txtKey" class="layui-input" placeholder="请输入关键字" />
                </div>
            </div>
            <div class="layui-inline">
                <button id="btnSearch" class="layui-btn layui-btn-primary">查询</button>
                <button id="btnAdd" class="layui-btn">新增</button>
                <button id="btnDelete" class="layui-btn layui-btn-danger">删除</button>
            </div>
        </div>
    </div>

    <table id="tableList" lay-filter="tableFilter"></table>

    <script src="~/layui/layui.js"></script>
    <script type="text/html" id="bar">
        <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
        <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
    </script>
    <script>
        layui.use(['table', 'layer'], function () {
            var table = layui.table,
                $ = layui.jquery,
                layer = layui.layer;

            table.render({
                elem: '#tableList',
                url: 'LoadData',
                page: true,
                limit: 10,
                limits: [10, 20, 30, 50],
                cols: [[
                    { type: 'checkbox', fixed: 'left' },
                    { field: 'Id', title: 'ID', width: 70, sort: true, align: 'center' },
                    { field: 'Title', title: '分类名称', width: 200 },
                    { field: 'ParentTitle', title: '父级分类', width: 200 },
                    { field: 'ClassLayer', title: '层级', width: 80, align: 'center' },
                    { field: 'Sort', title: '排序', width: 80, align: 'center' },
                    { field: 'SeoTitle', title: 'SEO标题', width: 200 },
                    { toolbar: '#bar', title: '操作', width: 180, align: 'center', fixed: 'right' }
                ]]
            });

            // 工具栏事件
            table.on('tool(tableFilter)', function (obj) {
                var data = obj.data;
                var layEvent = obj.event;
                if (layEvent === 'edit') {
                    layer.open({
                        type: 2,
                        title: '编辑文章分类',
                        area: ['700px', '580px'],
                        content: 'ArticleCategory/AddOrModify/' + data.Id
                    });
                } else if (layEvent === 'del') {
                    layer.confirm('确认要删除这条数据吗？', function (index) {
                        $.post('ArticleCategory/Delete', { ids: [data.Id] }, function (res) {
                            if (res.ResultCode === 0) {
                                layer.msg('删除成功');
                                table.reload('tableList');
                            } else {
                                layer.alert(res.ResultMsg);
                            }
                        });
                        layer.close(index);
                    });
                }
            });

            // 查询
            $('#btnSearch').on('click', function () {
                table.reload('tableList', { where: { Key: $('#txtKey').val() }, page: { curr: 1 } });
            });

            // 新增
            $('#btnAdd').on('click', function () {
                layer.open({
                    type: 2,
                    title: '新增文章分类',
                    area: ['700px', '580px'],
                    content: 'ArticleCategory/AddOrModify'
                });
            });

            // 批量删除
            $('#btnDelete').on('click', function () {
                var checkStatus = table.checkStatus('tableList');
                var ids = [];
                for (var i = 0; i < checkStatus.data.length; i++) {
                    ids.push(checkStatus.data[i].Id);
                }
                if (ids.length === 0) {
                    layer.msg('请至少选择一条数据');
                    return;
                }
                layer.confirm('确定要删除选中的 ' + ids.length + ' 条数据吗？', function (index) {
                    $.post('ArticleCategory/Delete', { ids: ids }, function (res) {
                        if (res.ResultCode === 0) {
                            layer.msg('删除成功');
                            table.reload('tableList');
                        } else {
                            layer.alert(res.ResultMsg);
                        }
                    });
                    layer.close(index);
                });
            });
        });
    </script>
</body>
</html>
